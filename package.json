{
  "name": "project-school",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:prod": "NODE_ENV=production node server/index.js",
    "server:staging": "NODE_ENV=staging node server/index.js",
    "seed": "node server/seed.js",
    "seed:supabase": "node server/supabase/seed-runner.js",
    
    "-- CI SCRIPTS (G50) --": "",
    "test": "node tests/runner.js",
    "test:unit": "node tests/runner.js --unit-only",
    "test:integration": "node tests/runner.js --integration-only",
    "test:browser": "npx playwright test",
    "lint": "eslint src server tests --max-warnings 200",
    "lint:fix": "eslint src server tests --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    
    "-- DEVELOPMENT --": "",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "preview": "vite preview",
    "start": "npm run server",
    "start:prod": "npm run server:prod",
    "start:staging": "npm run server:staging",
    "seed:dev": "node server/seed-dev.js",
    "seed:dev:reset": "node server/seed-dev.js --reset",
    
    "-- DATABASE --": "",
    "db:migrate": "node server/database/migrate-cli.js",
    "db:status": "node server/database/migrate-cli.js status",
    "db:init": "node server/database/migrate-cli.js init",
    
    "-- DATA MIGRATION (G52) --": "",
    "db:export": "node server/database/migration/export-source.js",
    "db:validate-source": "node server/database/migration/migrate-data.js --mode=validate",
    "db:migrate:preview": "node server/database/migration/migrate-data.js --mode=preview",
    "db:migrate:execute": "node server/database/migration/migrate-data.js --mode=execute"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.1"
  }
}
