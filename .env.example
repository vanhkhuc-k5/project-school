# EduPortal Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret — BẮT BUỘC thay đổi cho production
JWT_SECRET=your_super_secret_jwt_key_here

# Bcrypt rounds (10-12 cho production)
BCRYPT_ROUNDS=10

# Database path (SQLite fallback khi chưa cấu hình Supabase)
DB_PATH=./database.sqlite

# Neon PostgreSQL Configuration
DATABASE_URL=postgresql://username:password@ep-your-endpoint-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase Configuration (Tùy chọn)
# Lấy từ Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key


