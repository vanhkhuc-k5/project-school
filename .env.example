# =============================================================================
# EduPortal — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: development | test | staging | production
# REQUIRED for all environments
NODE_ENV=development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the Express API server
# DEFAULT: 5000
# REQUIRED: All environments
PORT=5000

# =============================================================================
# SECURITY — REQUIRED
# =============================================================================
# JWT Secret for signing access tokens (minimum 32 characters)
# IMPORTANT: Generate a secure random string for production
# Development: any value works (e.g., 32+ characters)
# Production: MUST be set to a cryptographically secure random string
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# Bcrypt rounds for password hashing (4-16)
# Development/Test: 4-10 (faster hashing)
# Production: 10-12 (more secure, slower)
# REQUIRED: All environments
BCRYPT_ROUNDS=10

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL (Neon Cloud) — Primary database for staging/production
# Leave empty to use SQLite only (development/test only)
# Format: postgresql://user:password@host:port/database?sslmode=require
# REQUIRED: Production
DATABASE_URL=

# SQLite — Local development fallback
# Use :memory: for isolated test environment
# DEFAULT: ./database.sqlite (development)
# NOT RECOMMENDED for production
DB_PATH=./database.sqlite

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Allowed origins for API requests (comma-separated)
# Development: http://localhost:5173 (Vite default)
# Staging: https://staging-portal.yourdomain.edu.vn
# Production: https://portal.yourdomain.edu.vn,https://www.yourdomain.edu.vn
# REQUIRED: All environments
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# AI TUTOR CONFIGURATION
# =============================================================================
# Enable/disable AI Tutor feature
# Development: true (default, uses mock provider)
# Production: true or false based on requirements
AI_TUTOR_ENABLED=true

# AI Provider selection
# Options: mock | openai | anthropic | gemini
# Development: mock (no API key needed)
# Production: openai | anthropic | gemini
# REQUIRED if AI_TUTOR_ENABLED=true and provider != mock
AI_PROVIDER=mock

# API Keys for AI providers (only needed if AI_PROVIDER != mock)
# Get keys from respective provider dashboards
# REQUIRED for production AI features
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: ERROR | WARN | INFO | DEBUG | TRACE
# Development: debug
# Staging: info
# Production: info or error
# REQUIRED: All environments
LOG_LEVEL=debug

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Allow SQLite in non-development environments
# WARNING: Not recommended for staging/production
# OPTIONS: true | false
# DEVELOPMENT ONLY
ALLOW_SQLITE_DEV=false

# Allow seeding in staging environment
# Useful for creating demo data in staging
# OPTIONS: true | false
# STAGING ONLY
ALLOW_SEED_IN_STAGING=false

# =============================================================================
# SUPABASE (Optional — for additional features)
# =============================================================================
# Supabase project URL
# SUPABASE_URL=https://your-project.supabase.co

# Supabase API keys (service role or anon key)
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# ENVIRONMENT-SPECIFIC NOTES
# =============================================================================
# DEVELOPMENT (.env with NODE_ENV=development):
#   - Uses SQLite by default
#   - Debug logging enabled
#   - JWT_SECRET can use default value
#   - Lower bcrypt rounds for faster testing

# TEST (.env.test or NODE_ENV=test):
#   - Uses in-memory SQLite (:memory:)
#   - Minimal logging (error only)
#   - Fixed test JWT_SECRET (auto-configured)
#   - Seeding disabled

# STAGING (.env with NODE_ENV=staging):
#   - MUST use PostgreSQL (no SQLite)
#   - Production-grade security settings
#   - Custom JWT_SECRET required
#   - Detailed logging for debugging

# PRODUCTION (.env with NODE_ENV=production):
#   - MUST use PostgreSQL
#   - MUST set secure JWT_SECRET (32+ chars)
#   - BCRYPT_ROUNDS=12
#   - Minimal logging (info level)
#   - HTTPS enforced
#   - Seeding disabled

# =============================================================================
# SECURE DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to staging/production, verify:
#
# [ ] JWT_SECRET is a cryptographically secure random string (32+ chars)
# [ ] DATABASE_URL is set and points to production PostgreSQL
# [ ] CORS_ORIGINS only includes your actual domains
# [ ] BCRYPT_ROUNDS is set to 12 for production
# [ ] AI provider API keys are set (if using AI features)
# [ ] ALLOW_SQLITE_DEV is false
# [ ] ALLOW_SEED_IN_STAGING is false (production)
# [ ] LOG_LEVEL is set to info or error
